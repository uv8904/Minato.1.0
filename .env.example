# ============================================================================
# FamPay auto-approval payments — TEMPLATE (docs/FAMPAY_SETUP.md)
#
# HOW TO USE:
#   1. Copy the lines below into your OWN `.env` file in the repo root.
#      (`.env` is gitignored — it can never be committed by accident.)
#   2. Replace every <...> placeholder with your real value.
#   3. Restart the bot. Logs must show: "FamPay: IMAP verifier started".
#
# NEVER put these values in a Telegram chat, a GitHub issue/PR or a commit —
# a leaked Gmail app password or API key lets anyone read your payment mails.
# On Heroku/Koyeb/Railway set the same names under Config Vars / Environment
# Variables instead of a .env file.
# ============================================================================

# --- required -------------------------------------------------------------
# Your FamPay UPI id (FamApp → Profile → UPI ID), e.g. dreamxbotz@fam
FAMPAY_UPI_ID=<yourname@fam>

# Gmail address linked to your FamPay account (receives the credit emails)
FAMPAY_EMAIL=<your-fampay-gmail@gmail.com>

# 16-character Google App Password — myaccount.google.com/apppasswords
# (needs 2-Step Verification ON + IMAP enabled in Gmail settings; this is NOT
# your normal Gmail password)
FAMPAY_EMAIL_PASSWORD=<xxxx xxxx xxxx xxxx>

# --- optional (sane defaults shown) ---------------------------------------
FAMPAY_ENABLED=True
FAMPAY_PAYEE_NAME=DreamXBotz
FAMPAY_ORDER_EXPIRY_MINUTES=10
FAMPAY_POLL_INTERVAL=20
FAMPAY_PLANS=10:7day,20:15day,40:1month,55:45day,75:60day
FAMPAY_IMAP_ENABLED=True
FAMPAY_IMAP_HOST=imap.gmail.com
FAMPAY_IMAP_PORT=993
FAMPAY_IMAP_MAILBOX=INBOX
# Only trusted FamApp system/no-reply payment mail is processed. Keep a FamApp
# domain or exact service address here (e.g. system@famapp.in).
FAMPAY_EMAIL_SENDER_FILTER=famapp.in
# MongoDB log used to avoid re-alerting the same unmatched UTR after a restart.
FAMPAY_EVENTS_COLLECTION=fampay_events

# --- optional fallback verifier (famgateway.in dashboard → API Keys) -------
# Leave empty to run IMAP-only. With a key: their QR is used, their status is
# polled, and their webhook approves instantly when the bot has a public URL.
FAMGATEWAY_API_KEY=
FAMGATEWAY_BASE_URL=https://famgateway.in
FAMGATEWAY_WEBHOOK_SECRET=

# --- bounded search cache (no Redis required) ------------------------------
# Set either to 0 to disable. Local file saves/deletes invalidate immediately.
# See docs/SEARCH_PERFORMANCE.md for multi-process freshness and benchmarking.
SEARCH_CACHE_SIZE=128
SEARCH_CACHE_TTL=30

# ============================================================================
# User-created bot clones (docs/CLONE_BOTS.md)
# ============================================================================
# Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never rotate this key without first deleting/migrating saved clone records.
CLONE_ENABLED=True
CLONE_ENCRYPTION_KEY=<generate-a-persistent-fernet-key>
CLONE_MAX_BOTS=1                 # hard cap; raise only after measuring real RAM
CLONE_MAX_RECORDS=100            # cap saved (including failed/paused) clone tokens
CLONE_MIN_FREE_RAM_MB=256        # reject clone starts below this cgroup/host headroom
CLONE_START_TIMEOUT=60           # seconds to wait for a clone to come online
CLONE_COLLECTION=minato_user_clones
CLONE_SESSION_WORKDIR=/tmp/minato_clone_sessions  # private (0700) directory for Telegram auth-session files

# ============================================================================
# JioHotstar-style OTT homepage + Inline Mode (docs/OTT_HOMEPAGE.md)
#
# Both features are ON by default: the storefront is served at /home (and "/"
# when OTT_HOME_AT_ROOT=True, while the old JSON probe stays on /health) and
# "@"BOT_USERNAME movie@"" answers inline in any chat. Nothing below is required.
# ============================================================================

# --- storefront (Option A) -------------------------------------------------
OTT_HOME=True                      # master switch for the pages + /api/ott/*
OTT_HOME_AT_ROOT=True              # also answer "/" with the storefront (JSON probe → /health)
OTT_HOME_PATH=/home
OTT_SEARCH_PATH=/search
OTT_HOME_API_PATH=/api/ott/home
OTT_SEARCH_API_PATH=/api/ott/search
OTT_GENRES_API_PATH=/api/ott/genres
OTT_MOVIE_API_PATH=/api/ott/movie
OTT_SUGGEST_API_PATH=/api/ott/suggest
OTT_RAIL_LIMIT=18                  # cards per rail (4-40)
OTT_RAILS_MAX=12                   # rails on the home page (1-20)
OTT_RAIL_MIN_ITEMS=4               # hide a rail with fewer cards than this
OTT_SERVER_RAILS=4                 # rails rendered into the HTML (the rest stream in via JSON)
OTT_HERO_LIMIT=6                   # trailer-hero rotation size (1-12)
OTT_GENRES=                        # preferred rail order, e.g. Action,Thriller,Comedy
OTT_CACHE_TTL=120                  # server-side rails/API cache in seconds (0 = off)
OTT_BROWSER_CACHE_TTL=60           # browser cache for the JSON APIs (0 = no-store)
OTT_POLL=90                        # live rails refresh while the tab is visible (0 = off)
OTT_SEARCH_LIMIT=24                # results per search page
OTT_SEARCH_MAX_LIMIT=60            # hard cap for ?limit= on /api/ott/search
OTT_SUGGEST_LIMIT=8                # type-ahead suggestions per keystroke
OTT_TRAILER_VOLUME=True            # hero trailers start muted (browser autoplay rules)
OTT_TRENDING_RAIL=True             # "Trending now" rail built from /topsearch data
OTT_TRENDING_LIMIT=12
OTT_META_COLLECTION=ott_meta       # Mongo collection caching genre/trailer metadata, e.g. ott_meta

# --- TMDB enrichment (genres, rating, runtime, trailer key) -----------------
# Uses TMDB_API_KEY / TMDB_ACCESS_TOKEN from the main config when set.
OTT_META_FETCH=True                # look genres/trailers up automatically in the background
OTT_TRAILER_FETCH=True             # keep the trailer hero (trailer key via TMDB)
OTT_META_LOOKUPS=40                # movies enriched per background pass (1-200)
OTT_META_RETRY_HOURS=72            # re-try a failed lookup after N hours
OTT_META_TIMEOUT=8                 # per-lookup timeout in seconds

# --- Inline Mode (Option B) ------------------------------------------------
INLINE_SEARCH=True                 # master switch for @bot <movie>
INLINE_SEARCH_LIMIT=20             # movie cards per query (1-50)
INLINE_SEARCH_CACHE_TTL=60         # Telegram-side answer cache in seconds
INLINE_SEARCH_POSTERS=True         # poster cards (falls back to text cards)
INLINE_SEARCH_GROUPS=True          # allow inline search outside private chats
INLINE_SEARCH_TOP=6                # results for an empty query (your top searches)
INLINE_SEARCH_MAX_QUERY=64         # longest accepted query
INLINE_SEARCH_MAX_REQUESTS=240     # per-user queries per hour (0 = unlimited)
