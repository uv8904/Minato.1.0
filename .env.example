# ============================================================================
# FamPay auto-approval payments — TEMPLATE (docs/FAMPAY_SETUP.md)
#
# HOW TO USE:
#   1. Copy the lines below into your OWN `.env` file in the repo root.
#      (`.env` is gitignored — it can never be committed by accident.)
#   2. Replace every <...> placeholder with your real value.
#   3. Restart the bot. Logs must show: "FamPay: IMAP verifier started".
#
# NEVER put these values in a Telegram chat, a GitHub issue/PR or a commit —
# a leaked Gmail app password or API key lets anyone read your payment mails.
# On Heroku/Koyeb/Railway set the same names under Config Vars / Environment
# Variables instead of a .env file.
# ============================================================================

# --- required -------------------------------------------------------------
# Your FamPay UPI id (FamApp → Profile → UPI ID), e.g. dreamxbotz@fam
FAMPAY_UPI_ID=<yourname@fam>

# Gmail address linked to your FamPay account (receives the credit emails)
FAMPAY_EMAIL=<your-fampay-gmail@gmail.com>

# 16-character Google App Password — myaccount.google.com/apppasswords
# (needs 2-Step Verification ON + IMAP enabled in Gmail settings; this is NOT
# your normal Gmail password)
FAMPAY_EMAIL_PASSWORD=<xxxx xxxx xxxx xxxx>

# --- optional (sane defaults shown) ---------------------------------------
FAMPAY_ENABLED=True
FAMPAY_PAYEE_NAME=DreamXBotz
FAMPAY_ORDER_EXPIRY_MINUTES=10
FAMPAY_POLL_INTERVAL=20
FAMPAY_PLANS=10:7day,20:15day,40:1month,55:45day,75:60day
FAMPAY_IMAP_ENABLED=True
FAMPAY_IMAP_HOST=imap.gmail.com
FAMPAY_IMAP_PORT=993
FAMPAY_IMAP_MAILBOX=INBOX
# Only trusted FamApp system/no-reply payment mail is processed. Keep a FamApp
# domain or exact service address here (e.g. system@famapp.in).
FAMPAY_EMAIL_SENDER_FILTER=famapp.in
# MongoDB log used to avoid re-alerting the same unmatched UTR after a restart.
FAMPAY_EVENTS_COLLECTION=fampay_events

# --- optional fallback verifier (famgateway.in dashboard → API Keys) -------
# Leave empty to run IMAP-only. With a key: their QR is used, their status is
# polled, and their webhook approves instantly when the bot has a public URL.
FAMGATEWAY_API_KEY=
FAMGATEWAY_BASE_URL=https://famgateway.in
FAMGATEWAY_WEBHOOK_SECRET=
